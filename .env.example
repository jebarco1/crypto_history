# Copy this file to .env and fill in the values you need.
# .env is not committed.

# Binance API key used when downloading candles.
# https://www.binance.com/en/my/settings/api-management
# Enable Reading only. Do not enable trading or withdrawals.
# The Binance secret key is not used by this app. Do not put it here.
# Leave blank to download public candles with no key.
BINANCE_API_KEY=

# Optional single token for the lookup API.
# Leave blank if you create named tokens with: php bin/token.php create --name=laptop
CRYPTO_API_TOKEN=

# Optional overrides.
# CRYPTO_DB_PATH=
# CRYPTO_BINANCE_BASE=https://data-api.binance.vision
# CRYPTO_INTERVAL=1h
# CRYPTO_YEARS=5
